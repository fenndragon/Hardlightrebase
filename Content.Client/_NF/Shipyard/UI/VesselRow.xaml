<PanelContainer>
    <MarginContainer Margin="6">

        <BoxContainer Orientation="Horizontal">

            <TextureRect Name="Thumbnail"
                         MinSize="96 64" />

            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          SeparationOverride="2">

                <Label Name="VesselName"
                       StyleClasses="LabelHeading" />

                <Label Name="VesselClass" />

                <Label Name="CrewCount" />

            </BoxContainer>

            <BoxContainer Orientation="Vertical"
                          HorizontalAlignment="Right">

                <Label Name="PriceLabel" />

                <Button Name="QuickPurchase"
                        Text="{Loc 'shipyard-buy'}" />

            </BoxContainer>

        </BoxContainer>

    </MarginContainer>
</PanelContainer>