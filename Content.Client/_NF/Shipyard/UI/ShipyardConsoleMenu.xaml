<DefaultWindow
    MinSize="1400 800"
    SetSize="1400 800"
    Title="{Loc 'shipyard-title'}">

    <BoxContainer Orientation="Horizontal">

        <!-- LEFT FILTER PANEL -->

        <PanelContainer MinSize="250 0">
            <MarginContainer Margin="8">
                <BoxContainer Orientation="Vertical" SeparationOverride="6">

                    <Label Text="{Loc 'shipyard-filters'}" />

                    <LineEdit Name="SearchFilter"
                              PlaceHolder="{Loc 'shipyard-search'}" />

                    <HSeparator />

                    <Label Text="{Loc 'shipyard-role'}" />

                    <VBoxContainer Name="RoleContainer">

                        <CheckBox Name="CargoFilter"
                                  Text="{Loc 'shipyard-role-cargo'}" />

                        <CheckBox Name="MiningFilter"
                                  Text="{Loc 'shipyard-role-mining'}" />

                        <CheckBox Name="ScienceFilter"
                                  Text="{Loc 'shipyard-role-science'}" />

                        <CheckBox Name="SecurityFilter"
                                  Text="{Loc 'shipyard-role-security'}" />

                        <CheckBox Name="MedicalFilter"
                                  Text="{Loc 'shipyard-role-medical'}" />

                    </VBoxContainer>

                    <HSeparator />

                    <Label Text="{Loc 'shipyard-size'}" />

                    <OptionButton Name="SizeFilter" />

                    <Label Text="{Loc 'shipyard-max-price'}" />

                    <LineEdit Name="PriceFilter" />

                </BoxContainer>
            </MarginContainer>
        </PanelContainer>

        <!-- SHIP LIST -->

        <PanelContainer HorizontalExpand="True">
            <MarginContainer Margin="8">
                <ScrollContainer HorizontalExpand="True"
                                 VerticalExpand="True">

                    <VBoxContainer Name="VesselList"
                                   SeparationOverride="4" />

                </ScrollContainer>
            </MarginContainer>
        </PanelContainer>

        <!-- DETAILS PANEL -->

        <PanelContainer MinSize="450 0">
            <MarginContainer Margin="8">
                <BoxContainer Orientation="Vertical"
                              SeparationOverride="6">

                    <TextureRect Name="ShipPreview"
                                 MinSize="420 240"
                                 Stretch="KeepCentered" />

                    <Label Name="ShipName"
                           StyleClasses="LabelHeading" />

                    <RichTextLabel Name="ShipDescription"
                                   VerticalExpand="True" />

                    <GridContainer Columns="2">

                        <Label Text="{Loc 'shipyard-price'}" />
                        <Label Name="PriceLabel" />

                        <Label Text="{Loc 'shipyard-crew'}" />
                        <Label Name="CrewLabel" />

                        <Label Text="{Loc 'shipyard-class'}" />
                        <Label Name="ClassLabel" />

                        <Label Text="{Loc 'shipyard-manufacturer'}" />
                        <Label Name="ManufacturerLabel" />

                    </GridContainer>

                    <HSeparator />

                    <BoxContainer Orientation="Horizontal">

                        <Button Name="PurchaseButton"
                                Text="{Loc 'shipyard-purchase'}"
                                HorizontalExpand="True" />

                        <Button Name="CompareButton"
                                Text="{Loc 'shipyard-compare'}" />

                    </BoxContainer>

                </BoxContainer>
            </MarginContainer>
        </PanelContainer>

    </BoxContainer>
</DefaultWindow>