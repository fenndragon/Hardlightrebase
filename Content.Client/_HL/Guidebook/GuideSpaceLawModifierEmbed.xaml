<BoxContainer xmlns="https://spacestation14.io"
              xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
              Orientation="Vertical"
              Margin="5 5 5 5">
    <PanelContainer HorizontalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BorderThickness="1" BorderColor="#777777"/>
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical">
            <PanelContainer Name="NameBackground" HorizontalExpand="True" VerticalExpand="False">
                <RichTextLabel Name="ModifierFullName" HorizontalAlignment="Center"/>
            </PanelContainer>

            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Text="Description" Margin="5 0 0 0"/>
                <RichTextLabel Name="ModifierDescription" Margin="10 0 10 0" HorizontalExpand="True"/>
            </BoxContainer>

            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Text="Adjustment" Margin="5 0 0 0"/>
                <RichTextLabel Name="ModifierAdjustment" Margin="10 0 10 0" HorizontalExpand="True"/>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
